{
  "name": "elytra",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "typecheck": "next typegen && tsc-rs --noEmit --tsBuildInfoFile .next/cache/tsc-rs.tsbuildinfo",
    "typecheck:tsc": "next typegen && tsc --noEmit --tsBuildInfoFile .next/cache/tsc.tsbuildinfo",
    "bench:typecheck": "node scripts/bench-typecheck.mjs",
    "start": "next start",
    "lint": "eslint",
    "seed": "node --experimental-strip-types --conditions=react-server --import ./scripts/register.mjs scripts/seed.ts",
    "agent-token": "node --experimental-strip-types --conditions=react-server --import ./scripts/register.mjs scripts/agent-token.ts",
    "ai-label": "node --experimental-strip-types --conditions=react-server --import ./scripts/register.mjs scripts/set-ai-label.ts",
    "test:backend": "node --experimental-strip-types --conditions=react-server --import ./scripts/register.mjs scripts/test-backend.ts",
    "test:api": "node --experimental-strip-types --conditions=react-server --import ./scripts/register.mjs scripts/test-api.ts",
    "test:e2ee": "node --experimental-strip-types --conditions=react-server --import ./scripts/register.mjs scripts/test-e2ee.ts",
    "test:concurrency": "node --experimental-strip-types --conditions=react-server --import ./scripts/register.mjs scripts/test-concurrency.ts",
    "seed:load": "node --experimental-strip-types --conditions=react-server --import ./scripts/register.mjs scripts/seed-load.ts",
    "load:api": "node scripts/load-api.mjs",
    "test:markdown": "node scripts/test-post-markdown.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsc-rs": "0.7.0",
    "typescript": "^5"
  }
}
