# Full browser URL, with no trailing slash or path.
ELYTRA_PUBLIC_ORIGIN=https://twitter.somedomain.org

# Connector token from the Cloudflare Tunnel Docker installation command.
# Keep the real token in .env, which is ignored by Git.
CLOUDFLARE_TUNNEL_TOKEN=

# Backend budgets (defaults shown). For Docker overrides, also add these to
# compose.yaml's app.environment. See docs/BACKEND.md for all settings.
# ELYTRA_API_CONCURRENCY=128
# ELYTRA_UPLOAD_CONCURRENCY=8
# ELYTRA_PASSWORD_CONCURRENCY=2
# ELYTRA_PASSWORD_QUEUE=32
# ELYTRA_BODY_TIMEOUT_MS=15000
# ELYTRA_DB_BUSY_TIMEOUT_MS=250
# ELYTRA_SNAPSHOT_ENTRIES=1000
# ELYTRA_SNAPSHOTS_PER_VIEWER=32
# ELYTRA_LOG_REQUESTS=true

# Optional text moderation. See docs/MODERATION.md for model download/conversion
# and the compose.moderation.yaml overlay. Defaults: off, shadow, borderline.
# ELYTRA_MODERATION=true
# ELYTRA_MODERATION_ESCALATION=borderline
# ELYTRA_MODERATION_ENFORCEMENT=off
# ELYTRA_MODERATION_PUBLISH=off
# ELYTRA_SLUR_ACTION=shadow
# ELYTRA_SLUR_NAMES=reject
# ELYTRA_GUARD_BACKEND=cpu
# ELYTRA_GUARD_URL=http://127.0.0.1:8081
# ELYTRA_GUARD_TIMEOUT_MS=5000
# ELYTRA_GUARD_QUEUE=16

# Compose sets cf-connecting-ip because the tunnel is its only ingress.
# For non-Docker hosting, set this only when that trusted proxy overwrites the
# chosen header and clients cannot reach the origin directly.
# ELYTRA_TRUSTED_IP_HEADER=x-real-ip
